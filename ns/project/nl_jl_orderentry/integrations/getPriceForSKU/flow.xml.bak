<?xml version="1.0" encoding="UTF-8"?>

<FLOW VERSION="1.0" CLEANUP="false">
  <COMMENT></COMMENT>

  <!-- nodes -->

<BRANCH SWITCH="/productSKU">
  <COMMENT></COMMENT>

  <!-- nodes -->

<SEQUENCE NAME="0001" EXIT-ON="FAILURE">
  <COMMENT></COMMENT>

  <!-- nodes -->

<MAP TIMEOUT="" MODE="STANDALONE">
  <COMMENT></COMMENT>
</MAP>
</SEQUENCE>

<SEQUENCE NAME="$default" EXIT-ON="FAILURE">
  <COMMENT></COMMENT>

  <!-- nodes -->

<SEQUENCE NAME="NEW" EXIT-ON="FAILURE">
  <COMMENT></COMMENT>
</SEQUENCE>
</SEQUENCE>
</BRANCH>

<MAP TIMEOUT="" MODE="STANDALONE">
  <COMMENT>Set Initial Price</COMMENT>

  <!-- nodes -->

<MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/price;1;0">
  <DATA ENCODING="XMLValues" I18N="true">

<Values version="2.0">
  <value name="xml">$0.00</value>
</Values>
</DATA>
</MAPSET>
</MAP>

<SEQUENCE NAME="NEW" EXIT-ON="FAILURE">
  <COMMENT></COMMENT>
</SEQUENCE>
</FLOW>
